---
import { Font } from 'astro:assets'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import Sprite from '../components/Sprite.astro'
import { href, langOf, otherPath } from '../data/i18n'
import { baseGraph, cardPath, webPage } from '../data/jsonld'
import { SITE_URL } from '../data/site'
import '../styles/site.css'

type Props = {
  title: string
  description: string
  /** Page-specific JSON-LD nodes, merged into the site-wide graph. */
  graph?: Record<string, unknown>[]
  /** A plain Markdown copy of this page for AI readers. */
  markdown?: string
  /** Keep this page out of search results (e.g. the form thank-you page). */
  noindex?: boolean
  /** Pages with no Arabic version (legal pages, 404). */
  englishOnly?: boolean
  /** Blog posts: Open Graph article tags. Dates are YYYY-MM-DD. */
  article?: { published: string; modified: string; section: string; tags: string[] }
  /** An RSS feed for this page (blog pages). */
  rss?: { href: string; title: string }
}
const lang = langOf(Astro.currentLocale)
const { title, description, graph = [], markdown, noindex, englishOnly, article, rss } = Astro.props
const path = Astro.url.pathname
const canonical = new URL(path, SITE_URL).href
const en = new URL(lang === 'en' ? path : otherPath(path), SITE_URL).href
// The share card is drawn after the build by src/integrations/og.ts.
const ogImage = new URL(cardPath(noindex ? href(lang, '/') : path), SITE_URL).href
const ar = englishOnly ? undefined : new URL(lang === 'ar' ? path : otherPath(path), SITE_URL).href
const ld = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [...baseGraph(lang), webPage(lang, canonical, title, description, ogImage), ...graph],
})
---
<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Page transitions opt in here, not in site.css: Chrome reads the opt-in before an uncached stylesheet arrives. -->
    <style is:inline>@view-transition{navigation:auto}</style>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {/* A noindex page (404, thank-you) has no address of its own for search engines to keep. */}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && <link rel="alternate" hreflang="en" href={en} />}
    {!noindex && ar && <link rel="alternate" hreflang="ar" href={ar} />}
    {!noindex && ar && <link rel="alternate" hreflang="x-default" href={en} />}
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    {rss && <link rel="alternate" type="application/rss+xml" title={rss.title} href={rss.href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && (
      <>
        <meta property="article:published_time" content={article.published} />
        <meta property="article:modified_time" content={article.modified} />
        <meta property="article:section" content={article.section} />
        {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}
    <meta property="og:site_name" content="Gym Thing" />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_BH' : 'en_GB'} />
    {ar && <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_GB' : 'ar_BH'} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />
    <Font cssVariable="--font-geist" preload />
    {lang === 'ar' && <Font cssVariable="--font-plex-arabic" preload={[{ weight: 400 }, { weight: 700 }]} />}
    <script type="application/ld+json" set:html={ld} />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-NKTD6FNG1H"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-NKTD6FNG1H');
    </script>
  </head>
  <body>
    <Sprite />
    <Header switchTo={englishOnly ? '/ar/' : otherPath(path)} />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site'
    </script>
  </body>
</html>
