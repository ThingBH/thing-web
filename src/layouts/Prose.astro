---
import Base from './Base.astro'

type Props = { frontmatter: { title: string; description: string } }
const { title, description } = Astro.props.frontmatter
---
<Base title={title} description={description} englishOnly>
  <article class="prose gutter">
    <div class="inner">
      <slot />
    </div>
  </article>
</Base>

<style>
  .prose {
    padding-top: 72px;
    padding-bottom: 96px;
  }
  .prose .inner {
    max-width: 68ch;
    color: var(--ink-2);
    line-height: 1.65;
  }
  .prose :global(h1) {
    margin: 0;
    color: var(--ink);
    font-size: clamp(40px, 6vw, 72px);
    line-height: 0.98;
    letter-spacing: -0.048em;
    text-wrap: balance;
  }
  .prose :global(h1 + p) {
    margin: 20px 0 40px;
    font-size: 14.5px;
    color: var(--soft);
  }
  .prose :global(h2) {
    margin: 48px 0 12px;
    color: var(--ink);
    font-size: 24px;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
  .prose :global(h3) {
    margin: 28px 0 8px;
    color: var(--ink);
    font-size: 18px;
    letter-spacing: -0.02em;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 16px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-inline-start: 1.3em;
    display: grid;
    gap: 6px;
  }
  .prose :global(strong) {
    color: var(--ink);
  }
  .prose :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  @media (max-width: 900px) {
    .prose {
      padding-top: 32px;
    }
  }
</style>
