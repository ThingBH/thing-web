---
import Base from '../layouts/Base.astro'
---
<Base title="Page not found · Gym Thing" description="The page you requested doesn't exist or has moved." englishOnly>
  <section class="page-hero gutter" aria-labelledby="h-404">
    <div class="inner">
      <h1 class="d1" id="h-404">We can't find that page.</h1>
      <p class="lede" style="margin-top:28px">The page you requested doesn't exist or has moved. Head back to the homepage to find what you need.</p>
      <div class="ctas" style="margin-top:32px">
        <a class="btn pri" href="/">Back to the homepage <svg class="i go"><use href="#i-arrow" /></svg></a>
        <a class="btn ghost" href="/modules/">See all modules</a>
      </div>
    </div>
  </section>
  <div class="gutter"><div class="inner" style="height:96px"></div></div>
</Base>
