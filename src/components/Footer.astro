---
import { content } from '../data/content'
import { href, langOf } from '../data/i18n'
import { contact } from '../data/site'
import Rich from './Rich.astro'

const lang = langOf(Astro.currentLocale)
const t = {
  en: {
    about: 'Gym Thing is gym management software by Thing W.L.L., Seef, Kingdom of Bahrain. CR\u00a0No.',
    modules: 'Modules',
    all: 'All modules',
    company: 'Company',
    aboutLink: 'About',
    support: 'Support',
    compare: 'Compare',
    blog: 'Blog',
    start: 'Start',
    trial: 'Start with a free trial',
    privacy: 'Privacy',
    terms: 'Terms',
    rights: 'All rights reserved.',
    tagline: 'Made by gym people, for gyms.',
    instagram: 'Thing on Instagram (opens in a new tab)',
    linkedin: 'Thing on LinkedIn (opens in a new tab)',
  },
  ar: {
    about: 'Gym Thing برنامج لإدارة النوادي الرياضية من Thing W.L.L.، السيف، مملكة البحرين. سجل تجاري رقم',
    modules: 'الأقسام',
    all: 'كل الأقسام',
    company: 'الشركة',
    aboutLink: 'من نحن',
    support: 'الدعم',
    compare: 'المقارنة',
    blog: 'المدونة',
    start: 'ابدأ',
    trial: 'ابدأ بتجربة مجانية',
    privacy: 'الخصوصية',
    terms: 'الشروط',
    rights: 'جميع الحقوق محفوظة.',
    tagline: 'من ناس النوادي، للنوادي.',
    instagram: 'Thing على إنستغرام (يفتح في تبويب جديد)',
    linkedin: 'Thing على لينكدإن (يفتح في تبويب جديد)',
  },
}[lang]
---
<footer class="foot gutter">
  <div class="inner">
    <div class="foot-grid">
      <div>
        <svg class="logo" viewBox="0 0 720 410" role="img" aria-label="Thing"><use href="#thing-logo" /></svg>
        <p class="small" style="max-width:34ch"><Rich text={t.about} />&nbsp;<bdi dir="ltr" style="white-space:nowrap">196454-1</bdi>.</p>
        <ul class="social">
          <li><a href={contact.instagram} target="_blank" rel="noopener" aria-label={t.instagram}><svg class="i" aria-hidden="true"><use href="#i-instagram" /></svg></a></li>
          <li><a href={contact.linkedin} target="_blank" rel="noopener" aria-label={t.linkedin}><svg class="i" aria-hidden="true"><use href="#i-linkedin" /></svg></a></li>
        </ul>
      </div>
      <div>
        <h2>{t.modules}</h2>
        <ul>{content[lang].modules.slice(0, 6).map((m) => <li><a href={href(lang, `/modules/${m.slug}/`)}>{m.name}</a></li>)}<li><a href={href(lang, '/modules/')}>{t.all}</a></li></ul>
      </div>
      <div>
        <h2>{t.company}</h2>
        <ul><li><a href={href(lang, '/about/')}>{t.aboutLink}</a></li><li><a href={href(lang, '/about/#support')}>{t.support}</a></li><li><a href={href(lang, '/compare/')}>{t.compare}</a></li><li><a href={href(lang, '/blog/')}>{t.blog}</a></li></ul>
      </div>
      <div>
        <h2>{t.start}</h2>
        <!-- Legal pages are English only. -->
        <ul><li><a href={href(lang, '/free-trial/')}>{t.trial}</a></li><li><a href="/privacy/" hreflang="en">{t.privacy}</a></li><li><a href="/terms/" hreflang="en">{t.terms}</a></li></ul>
      </div>
    </div>
    <div class="foot-base"><span>© {new Date().getFullYear()} Thing W.L.L. {t.rights}</span><span>{t.tagline}</span></div>
  </div>
</footer>
