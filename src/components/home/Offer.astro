---
import { href, langOf } from '../../data/i18n'
import { included } from '../../data/site'

const lang = langOf(Astro.currentLocale)
const t = {
  en: {
    h: 'One yearly price for your size.',
    p: 'No add-ons, nothing locked, in Bahraini dinars. Every gym gets all of this:',
    cta: 'Start with a free trial',
  },
  ar: {
    h: 'سعر سنوي واحد حسب حجمك.',
    p: 'بدون إضافات، ولا شي مقفول، وبالدينار البحريني. كل نادي ياخذ كل هذا:',
    cta: 'ابدأ بتجربة مجانية',
  },
}[lang]
---
<div class="offer">
  <article class="offer-all wide">
    <h3>{t.h}</h3>
    <p class="body">{t.p}</p>
    <ul>{included[lang].map((i) => <li><svg class="i"><use href="#i-check" /></svg>{i}</li>)}</ul>
    <a class="btn pri" href={href(lang, '/free-trial/')}>{t.cta} <svg class="i go"><use href="#i-arrow" /></svg></a>
  </article>
</div>
